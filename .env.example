# Database (Supabase: Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Security
ADMIN_PASSWORD=choose-a-long-password
CRON_SECRET=any-long-random-string

# Which channel reminds the admin: telegram | email | whatsapp
NOTIFY_CHANNEL=telegram

# Birthdays are matched against today's date in this timezone
TIMEZONE=Africa/Lagos
# Optional wish text, {name} is replaced
# WISH_TEMPLATE=Happy birthday, {name}! Wishing you good health, joy and success.

# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Birthday Desk <reminders@yourdomain.com>
ADMIN_EMAIL=

# whatsapp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
ADMIN_WHATSAPP=
WHATSAPP_TEMPLATE=
WHATSAPP_API_VERSION=v23.0
